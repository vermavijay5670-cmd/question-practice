  { id: 'bfc-ar-18', type: 'assertion-reason', question: 'Assertion (A): Hypertension has no significant long-term health consequences.\nReason (R): Chronically elevated blood pressure can damage blood vessels and increase the risk of heart disease and stroke.', options: ['Both A and R are true, and R is the correct explanation of A', 'Both A and R are true, but R is NOT the correct explanation of A', 'A is true, but R is false', 'A is false, but R is true'], correctIndex: 3, explanation: 'Hypertension DOES have significant consequences (A is false); R correctly describes these real health risks.', difficulty: 'medium' },
  { id: 'bfc-ar-19', type: 'assertion-reason', question: 'Assertion (A): Coronary artery disease can lead to reduced blood supply to the heart muscle.\nReason (R): It typically involves atherosclerotic plaque deposition narrowing the coronary arteries.', options: ['Both A and R are true, and R is the correct explanation of A', 'Both A and R are true, but R is NOT the correct explanation of A', 'A is true, but R is false', 'Both A and R are false'], correctIndex: 0, explanation: 'Plaque-narrowed coronary arteries directly explain the reduced blood supply seen in coronary artery disease.', difficulty: 'medium' },
  { id: 'bfc-ar-20', type: 'assertion-reason', question: 'Assertion (A): Thrombocytopenia refers to an excess of platelets in the blood.\nReason (R): Thrombocytopenia specifically refers to an abnormally low platelet count.', options: ['Both A and R are true, and R is the correct explanation of A', 'Both A and R are true, but R is NOT the correct explanation of A', 'A is true, but R is false', 'A is false, but R is true'], correctIndex: 3, explanation: 'Thrombocytopenia actually means LOW (not excess) platelet count (A is false); R correctly defines the real condition.', difficulty: 'medium' },

  // ---- Statement-based ----
  { id: 'bfc-st-1', type: 'statement', question: 'Statement I: Plasma makes up about 55% of blood volume.\nStatement II: Formed elements (RBCs, WBCs, platelets) make up the remaining volume.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 0, explanation: 'Both statements correctly describe the general composition of whole blood.', difficulty: 'easy' },
  { id: 'bfc-st-2', type: 'statement', question: 'Statement I: Albumin is the most abundant plasma protein.\nStatement II: Fibrinogen is essential for blood clotting.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 0, explanation: 'Both statements correctly describe these key plasma proteins and their roles.', difficulty: 'medium' },
  { id: 'bfc-st-3', type: 'statement', question: 'Statement I: Mature human RBCs contain a nucleus.\nStatement II: RBCs have an average lifespan of about 120 days.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 3, explanation: 'Statement I is incorrect — mature human RBCs lack a nucleus; Statement II correctly states their average lifespan.', difficulty: 'medium' },
  { id: 'bfc-st-4', type: 'statement', question: 'Statement I: Neutrophils and eosinophils are granulocytes.\nStatement II: Lymphocytes and monocytes are agranulocytes.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 0, explanation: 'Both statements correctly classify these white blood cell types.', difficulty: 'medium' },
  { id: 'bfc-st-5', type: 'statement', question: 'Statement I: Platelets are complete cells with a nucleus.\nStatement II: Platelets are derived from megakaryocytes in the bone marrow.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 3, explanation: 'Statement I is incorrect — platelets are cell fragments, not complete nucleated cells; Statement II correctly describes their origin.', difficulty: 'medium' },
  { id: 'bfc-st-6', type: 'statement', question: 'Statement I: Blood group O individuals have both A and B antigens on their RBCs.\nStatement II: Blood group AB individuals lack anti-A and anti-B antibodies.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 3, explanation: 'Statement I is incorrect — group O has NEITHER A nor B antigens; Statement II correctly describes group AB.', difficulty: 'medium' },
  { id: 'bfc-st-7', type: 'statement', question: 'Statement I: The Rh factor is named after the Rhesus monkey.\nStatement II: Erythroblastosis foetalis can result from Rh incompatibility between mother and foetus.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 0, explanation: 'Both statements correctly describe the Rh factor and its clinical significance.', difficulty: 'medium' },
  { id: 'bfc-st-8', type: 'statement', question: 'Statement I: Lymph is bright red in colour due to high haemoglobin content.\nStatement II: Lymph helps drain excess interstitial fluid back into the bloodstream.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 3, explanation: 'Statement I is incorrect — lymph is colourless, not bright red; Statement II correctly describes a key lymphatic function.', difficulty: 'medium' },
  { id: 'bfc-st-9', type: 'statement', question: 'Statement I: The human heart has four chambers.\nStatement II: The heart is enclosed within the pericardium.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 0, explanation: 'Both statements correctly describe basic heart anatomy.', difficulty: 'easy' },
  { id: 'bfc-st-10', type: 'statement', question: 'Statement I: The tricuspid valve is located between the left atrium and left ventricle.\nStatement II: The bicuspid (mitral) valve is located between the left atrium and left ventricle.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 3, explanation: 'Statement I is incorrect — the tricuspid valve is on the RIGHT side of the heart; Statement II correctly places the bicuspid valve.', difficulty: 'medium' },
  { id: 'bfc-st-11', type: 'statement', question: 'Statement I: The SA node is located in the right atrium.\nStatement II: The SA node generates the rhythmic impulses that initiate heartbeats.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 0, explanation: 'Both statements correctly describe the SA node and its pacemaker function.', difficulty: 'medium' },
  { id: 'bfc-st-12', type: 'statement', question: 'Statement I: Systole refers to the relaxation phase of the cardiac cycle.\nStatement II: Diastole refers to the contraction phase of the cardiac cycle.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 1, explanation: 'Both statements have the definitions reversed — systole is contraction, and diastole is relaxation.', difficulty: 'medium' },
  { id: 'bfc-st-13', type: 'statement', question: 'Statement I: Cardiac output is calculated as stroke volume multiplied by heart rate.\nStatement II: A normal resting heart rate is about 72–75 beats per minute in a healthy adult.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 0, explanation: 'Both statements correctly describe cardiac output calculation and normal resting heart rate.', difficulty: 'medium' },
  { id: 'bfc-st-14', type: 'statement', question: 'Statement I: The P wave in an ECG represents ventricular depolarisation.\nStatement II: The QRS complex represents ventricular depolarisation.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 3, explanation: 'Statement I is incorrect — the P wave represents ATRIAL (not ventricular) depolarisation; Statement II correctly describes the QRS complex.', difficulty: 'medium' },
  { id: 'bfc-st-15', type: 'statement', question: 'Statement I: Arteries generally carry blood away from the heart.\nStatement II: Veins generally carry blood back toward the heart.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 0, explanation: 'Both statements correctly describe the general direction of blood flow in arteries and veins.', difficulty: 'easy' },
  { id: 'bfc-st-16', type: 'statement', question: 'Statement I: Capillaries have thick, multi-layered walls.\nStatement II: Capillaries are the primary site of exchange between blood and tissues.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 3, explanation: 'Statement I is incorrect — capillary walls are extremely thin, not thick/multi-layered; Statement II correctly describes their exchange function.', difficulty: 'medium' },
  { id: 'bfc-st-17', type: 'statement', question: 'Statement I: Hypertension refers to abnormally low blood pressure.\nStatement II: Coronary artery disease often results from atherosclerotic plaque buildup.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 3, explanation: 'Statement I is incorrect — hypertension is abnormally HIGH (not low) blood pressure; Statement II correctly describes coronary artery disease.', difficulty: 'medium' },
  { id: 'bfc-st-18', type: 'statement', question: 'Statement I: Angina is characterised by chest pain due to inadequate oxygen supply to heart muscle.\nStatement II: Angina always results in permanent, irreversible damage to the heart muscle.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 2, explanation: 'Statement I is correct; Statement II is incorrect — angina itself does not necessarily cause permanent damage, unlike a full heart attack.', difficulty: 'medium' },
  { id: 'bfc-st-19', type: 'statement', question: 'Statement I: Thrombocytopenia refers to a low platelet count.\nStatement II: Low platelet counts can increase the risk of excessive bleeding.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 0, explanation: 'Both statements correctly describe thrombocytopenia and its clinical consequence.', difficulty: 'medium' },
  { id: 'bfc-st-20', type: 'statement', question: 'Statement I: Blood clotting involves the conversion of prothrombin to thrombin.\nStatement II: Thrombin then converts fibrinogen into fibrin, forming the clot.', options: ['Both correct', 'Both incorrect', 'I correct, II incorrect', 'II correct, I incorrect'], correctIndex: 0, explanation: 'Both statements correctly describe key sequential steps in the blood clotting cascade.', difficulty: 'medium' },

  // ---- "How many of the following are correct" ----
  { id: 'bfc-hm-1', type: 'statement', question: 'How many of the following are formed elements (cellular components) of blood?\nRed blood cells, White blood cells, Platelets, Plasma', options: ['One', 'Two', 'Three', 'Four'], correctIndex: 2, explanation: 'RBCs, WBCs, and platelets are the formed elements; plasma is the fluid matrix, not a formed element.', difficulty: 'medium' },
  { id: 'bfc-hm-2', type: 'statement', question: 'How many of the following are granulocyte types of white blood cells?\nNeutrophil, Eosinophil, Basophil, Lymphocyte', options: ['One', 'Two', 'Three', 'Four'], correctIndex: 2, explanation: 'Neutrophils, eosinophils, and basophils are granulocytes; lymphocytes are agranulocytes.', difficulty: 'medium' },
  { id: 'bfc-hm-3', type: 'statement', question: 'How many of the following are agranulocyte types of white blood cells?\nLymphocyte, Monocyte, Neutrophil, Basophil', options: ['One', 'Two', 'Three', 'Four'], correctIndex: 1, explanation: 'Lymphocytes and monocytes are agranulocytes; neutrophils and basophils are granulocytes.', difficulty: 'medium' },
  { id: 'bfc-hm-4', type: 'statement', question: 'How many of the following are true regarding the ABO blood group system?\nGroup AB has both A and B antigens, Group O has neither A nor B antigens, Group AB is called the universal donor, Group O RBCs can generally be given to most recipients', options: ['One', 'Two', 'Three', 'Four'], correctIndex: 2, explanation: 'The first, second, and fourth statements are correct; Group AB is the universal RECIPIENT (not donor) — group O RBCs are the universal donor type.', difficulty: 'medium' },
  { id: 'bfc-hm-5', type: 'statement', question: 'How many of the following are chambers of the human heart?\nRight atrium, Left atrium, Right ventricle, Left ventricle', options: ['One', 'Two', 'Three', 'All four'], correctIndex: 3, explanation: 'All four listed structures are genuine chambers of the human heart.', difficulty: 'easy' },
  { id: 'bfc-hm-6', type: 'statement', question: 'How many of the following are true regarding heart valves?\nTricuspid valve is between right atrium and right ventricle, Bicuspid valve is between left atrium and left ventricle, Valves prevent backflow of blood, Valves generate the heartbeat rhythm', options: ['One', 'Two', 'Three', 'Four'], correctIndex: 2, explanation: 'The first three statements are correct; the SA node (not valves) generates the heartbeat rhythm.', difficulty: 'medium' },
  { id: 'bfc-hm-7', type: 'statement', question: 'How many of the following are correctly part of the cardiac conduction pathway (in sequence)?\nSA node, AV node, Bundle of His, Purkinje fibres', options: ['One', 'Two', 'Three', 'All four'], correctIndex: 3, explanation: 'All four structures are genuine, sequential parts of the cardiac electrical conduction pathway.', difficulty: 'medium' },
  { id: 'bfc-hm-8', type: 'statement', question: 'How many of the following are true regarding the ECG?\nP wave represents atrial depolarisation, QRS complex represents ventricular depolarisation, ECG records mechanical pumping directly (not electrical activity), T wave represents ventricular repolarisation', options: ['One', 'Two', 'Three', 'Four'], correctIndex: 2, explanation: 'The first, second, and fourth statements are correct; the ECG records ELECTRICAL (not mechanical) activity of the heart.', difficulty: 'medium' },
  { id: 'bfc-hm-9', type: 'statement', question: 'How many of the following are circulatory system disorders?\nHypertension, Coronary artery disease, Angina, Osteoporosis', options: ['One', 'Two', 'Three', 'Four'], correctIndex: 2, explanation: 'Hypertension, coronary artery disease, and angina are circulatory disorders; osteoporosis is a bone disorder.', difficulty: 'medium' },
  { id: 'bfc-hm-10', type: 'statement', question: 'How many of the following are true regarding lymph?\nIt is formed from interstitial fluid, It is colourless, It has a lower protein content than plasma, It transports absorbed fats from the intestine', options: ['One', 'Two', 'Three', 'All four'], correctIndex: 3, explanation: 'All four statements correctly describe the formation, appearance, composition, and function of lymph.', difficulty: 'medium' },
